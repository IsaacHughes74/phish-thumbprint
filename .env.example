# phish.net v5 API key (server-side only; sent as the `X-API-KEY` header).
# Named `X-API-KEY` per spec. If a platform cannot set a name with a dash,
# the code still reads process.env['X-API-KEY'] — set it exactly as shown.
X-API-KEY=

# Neon Postgres connection string (server-side only).
DATABASE_URL=

# Bust-out gap threshold; defaults to 50 when unset.
BUST_OUT_GAP_THRESHOLD=50
