# phish.net v5 API key (server-side only; sent as the `X-API-KEY` header).
PHISHNET_API_KEY=

# Neon Postgres connection string (server-side only).
DATABASE_URL=

# Better Auth session-signing secret (required to boot; e.g. `openssl rand -base64 32`).
BETTER_AUTH_SECRET=

# Better Auth base URL (the app's own origin; required to boot).
BETTER_AUTH_URL=http://localhost:3000

# Apple Sign-in credentials (server-side only; read lazily at sign-in, so a
# missing key surfaces at sign-in rather than a boot crash).
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_PRIVATE_KEY=

# Bust-out gap threshold; defaults to 50 when unset.
BUST_OUT_GAP_THRESHOLD=50

# Optional dev-only: origins allowed to reach the dev server (e.g. a Cloudflare
# Tunnel host). Comma-separated. Only affects `next dev`; leave unset in prod.
# ALLOWED_DEV_ORIGINS=
